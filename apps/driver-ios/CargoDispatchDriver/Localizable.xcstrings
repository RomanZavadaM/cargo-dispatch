    "error.connection": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зв’язатися з Control. Перевірте адресу й з’єднання."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not reach Control. Check the address and connection."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Control ist nicht erreichbar. Adresse und Verbindung prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre Control. Vérifiez l’adresse et la connexion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con Control. Comprueba la dirección y la conexión."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Control에 연결할 수 없습니다. 주소와 연결을 확인하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Control に接続できません。アドレスと接続を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到 Control。请检查地址和网络连接。"
          }
        }
      }
    },
