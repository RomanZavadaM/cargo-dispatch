    "location.tracking.active": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відстеження рейсу активне"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trip tracking is active"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tour-Tracking ist aktiv"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le suivi du trajet est actif"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El seguimiento del viaje está activo"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운행 추적이 활성화됨"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "運行追跡中"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "行程跟踪已启用"
          }
        }
      }
    },
    "location.tracking.note": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки відстеження увімкнене, позиція передається й у фоні. «Зупинити» повністю вимикає безперервний GPS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While tracking is on, your position is also sent in the background. “Stop” turns continuous GPS off completely."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange die Verfolgung läuft, wird die Position auch im Hintergrund gesendet. „Beenden“ schaltet das Dauer-GPS ganz ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que le suivi est actif, la position est aussi envoyée en arrière-plan. « Arrêter » coupe complètement le GPS continu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el seguimiento activo, la posición se envía también en segundo plano. «Detener» apaga el GPS continuo por completo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추적 중에는 백그라운드에서도 위치를 전송합니다. ‘중지’를 누르면 연속 GPS가 완전히 꺼집니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追跡中はバックグラウンドでも位置を送信します。「停止」で連続 GPS は完全にオフになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "追踪开启时后台也会发送位置。点击“停止”将完全关闭持续定位。"
          }
        }
      }
    },
    "status.connected": {
