{
  "sourceLanguage": "uk",
  "strings": {
    "screen.title": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo Dispatch — Водій"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo Dispatch — Driver"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo Dispatch — Fahrer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo Dispatch — Conducteur"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo Dispatch — Conductor"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo Dispatch — 운전자"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo Dispatch — ドライバー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo Dispatch — 司机"
          }
        }
      }
    },
    "screen.subtitle": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нативний iPhone/iPad-клієнт використовує той самий Control API, що й Driver Browser."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The native iPhone/iPad client uses the same Control API as Driver Browser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der native iPhone/iPad-Client verwendet dieselbe Control-API wie der Driver Browser."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le client natif iPhone/iPad utilise la même API Control que Driver Browser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cliente nativo de iPhone/iPad usa la misma API de Control que Driver Browser."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네이티브 iPhone/iPad 클라이언트는 Driver Browser와 동일한 Control API를 사용합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネイティブ iPhone/iPad クライアントは Driver Browser と同じ Control API を使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生 iPhone/iPad 客户端使用与 Driver Browser 相同的 Control API。"
          }
        }
      }
    },
