{
  "sourceLanguage": "uk",
  "strings": {
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo Dispatch використовує геолокацію, щоб передати поточну позицію водія в Control."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo Dispatch uses location to send the driver's current position to Control."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo Dispatch verwendet den Standort, um die aktuelle Fahrerposition an Control zu senden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo Dispatch utilise la localisation pour envoyer la position actuelle du conducteur à Control."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo Dispatch usa la ubicación para enviar la posición actual del conductor a Control."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo Dispatch는 운전자의 현재 위치를 Control로 전송하기 위해 위치 정보를 사용합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo Dispatch はドライバーの現在地を Control に送信するために位置情報を使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo Dispatch 使用位置信息将司机当前位置发送到 Control。"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo Dispatch використовує камеру, щоб водій міг передати в Control фото та відео з рейсу."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo Dispatch uses the camera so the driver can send trip photos and videos to Control."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo Dispatch verwendet die Kamera, damit der Fahrer Fotos und Videos der Tour an Control senden kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo Dispatch utilise la caméra afin que le conducteur puisse envoyer à Control des photos et vidéos du trajet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo Dispatch usa la cámara para que el conductor pueda enviar a Control fotos y vídeos del viaje."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo Dispatch는 운전자가 운행 사진과 동영상을 Control로 전송할 수 있도록 카메라를 사용합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo Dispatch はドライバーが運行中の写真や動画を Control に送信するためにカメラを使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo Dispatch 使用相机，以便司机将行程照片和视频发送到 Control。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo Dispatch використовує мікрофон лише для запису звуку під час відео, яке водій передає в Control."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo Dispatch uses the microphone only to record audio with videos the driver sends to Control."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo Dispatch verwendet das Mikrofon nur für den Ton von Videos, die der Fahrer an Control sendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo Dispatch utilise le microphone uniquement pour enregistrer le son des vidéos envoyées par le conducteur à Control."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo Dispatch usa el micrófono solo para grabar el audio de los vídeos que el conductor envía a Control."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo Dispatch는 운전자가 Control로 보내는 동영상의 오디오를 녹음할 때만 마이크를 사용합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo Dispatch はドライバーが Control に送信する動画の音声を録音する場合にのみマイクを使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo Dispatch 仅在司机录制并发送到 Control 的视频中使用麦克风录音。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
