{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cargo Dispatch Control",
  "version": "0.1.0",
  "identifier": "ua.cargodispatch.control",
  "build": {
    "frontendDist": "../../control-ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "control",
        "title": "Cargo Dispatch — Control",
        "userAgent": "CargoDispatchControl/0.1.0 (+https://github.com/RomanZavadaM/cargo-dispatch)",
        "width": 1080,
        "height": 760,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}
