# Public DNS name of the test gateway/TURN host.
CARGO_PUBLIC_HOST=cargo-test.example.org

# Same secret is used by gateway to issue short-lived TURN credentials
# and by coturn to verify them. Generate a long random value on the server.
CARGO_TURN_SECRET=replace-with-long-random-secret

# TURN authentication realm.
CARGO_TURN_REALM=cargo-test.example.org
